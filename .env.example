# --- shared ---
NODE_ENV=development

# --- envelope encryption ---
# 32-byte master key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: source from Doppler / Infisical, NEVER commit.
XBT_KEK=

# --- postgres (DO Managed Postgres) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/xbottrader

# --- redis (DO Managed Caching / local) ---
REDIS_URL=redis://localhost:6379

# --- gateway ---
GATEWAY_PORT=4000
GATEWAY_SESSION_SECRET=
GATEWAY_INTERNAL_HMAC_SECRET=

# --- bot engine ---
BOT_ENGINE_PORT=5001

# --- ai engine ---
AI_ENGINE_PORT=5002
ANTHROPIC_API_KEY=

# --- stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- spaces (DO Spaces, S3-compatible) ---
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=xbottrader
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
